# Mining Match server settings. Copy to /etc/mining-match.env, fill in, and keep it private
# (chmod 640, owned by root:miningmatch). Never commit the filled-in copy.
# Put double quotes around any value with spaces: the daily job reads this file with the shell.

MM_DB=/srv/mining-match/data/mining_match.db
MM_FILES=/srv/mining-match/data/uploads
MM_BASE_URL=https://miningmatch.example.com.au
MM_DOCS=0
MM_SECURE_COOKIES=1
MM_TIMEZONE=Australia/Brisbane
# MM_CORS_ORIGINS=   # only if another website must call the API from a browser

# Email (STARTTLS). The mail server's certificate and name are checked, so MM_SMTP_HOST must be the
# name on the provider's certificate (e.g. email-smtp.ap-southeast-2.amazonaws.com), not an IP address.
# Without MM_SMTP_HOST, emails are only printed to the log.
MM_SMTP_HOST=
MM_SMTP_PORT=587
MM_SMTP_USER=
MM_SMTP_PASSWORD=
MM_MAIL_FROM="Mining Match <no-reply@miningmatch.example.com.au>"

# Invoicing (off until MM_ABN is set). Bank details live only here, never in the website.
MM_BUSINESS_NAME=
MM_ABN=
MM_BUSINESS_ADDRESS=
MM_BILLING_EMAIL=
MM_BUSINESS_PHONE=
MM_GST_REGISTERED=1
MM_BANK_ACCOUNT_NAME=
MM_BANK_BSB=
MM_BANK_ACCOUNT=
# MM_PAYID=
MM_PAYMENT_TERMS_DAYS=14
MM_INVOICE_PREFIX=MM

# Backups (deploy/backup.sh; see docs/DEPLOYMENT.md). Required: backups are never written
# unencrypted. The age PUBLIC key (age1...) they're encrypted to; keep the private key
# (AGE-SECRET-KEY-...) off this server. Make one on your own computer with:
#   age-keygen -o mining-match-backup-key.txt
MM_BACKUP_RECIPIENT=
# Who gets an email if a backup fails.
MM_BACKUP_ALERT_EMAIL=
# MM_BACKUP_KEEP_DAYS=14

# Security monitoring (python/monitoring.py): who gets alerts about server errors, failing
# checks (site, HTTPS certificate, disk, backups, ClamAV), suspicious activity and admin logins.
MM_ALERT_EMAIL=

# Virus scanning of uploads (always on for a live site; see docs/DEPLOYMENT.md). Keep ClamAV on this
# server: a scanner on another machine is refused unless MM_CLAMD_ALLOW_REMOTE=1 (tunnelled only).
# MM_CLAMD_SOCKET=/var/run/clamav/clamd.ctl
# MM_CLAMD_TIMEOUT=30
